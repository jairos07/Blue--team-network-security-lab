# /etc/bind/named.conf.local
# BIND9 zone declarations — Blue Team Lab
# This server is the authoritative DNS for red.local and its reverse zone.

# Forward zone — resolves hostnames to IPs within red.local
zone "red.local" {
    type master;
    file "/etc/bind/db.red.local";
};

# Reverse zone — resolves IPs back to hostnames (PTR records) for 192.168.100.0/24
zone "100.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/db.192.168.100";
};
